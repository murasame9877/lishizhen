# 微信公众平台测试号
WECHAT_TOKEN=replace-with-random-token
WECHAT_APPID=
WECHAT_APPSECRET=
# plain | compatible | safe（优先 plain，最简单）
WECHAT_ENCRYPT_MODE=plain

# 公网地址（Cloudflare Tunnel 或 https://你的域名）
PUBLIC_BASE_URL=http://localhost:8000

# 存储
DB_PATH=data/sdg.sqlite3
TZ=Asia/Shanghai

# 同步与解析
CONFIDENCE_THRESHOLD=0.8
SYNC_INTERVAL_MIN=10
SYNC_SCHEDULER_ENABLED=true

# 异步解析与主动推送
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1
WECHAT_PUSH_ENABLED=true

# 公众号文章抓取
ARTICLE_TIMEOUT=15
ARTICLE_MAX_CHARS=12000
ARTICLE_USER_AGENT=

# 手机分享目标（HTTP Shortcuts / 自建 App）
SHARE_INGEST_TOKEN=replace-with-random-token
SHARE_USER_OPENID=

# 企业微信「微信客服」：官方聊天对象，主动拉取消息
WECOM_KF_ENABLED=false
WECOM_CORP_ID=
WECOM_KF_SECRET=
WECOM_KF_ID=
WECOM_KF_USER_OPENID=
WECOM_AGENT_ID=

# CalDAV（Radicale）
# 手机端使用公网地址；服务端同步走本机回环，避免绕隧道
CALDAV_URL=https://example.com/radicale/
CALDAV_INTERNAL_URL=http://127.0.0.1:8000/radicale/
CALDAV_USERNAME=sdg
CALDAV_PASSWORD=replace-me
CALDAV_CALENDAR_NAME=日程Agent

# 现场演示：true 时只有 CALDAV_SYNC_OPENIDS 里的 openid 会写系统日历
# 观众仍可在微信内体验卡片、列表、改、删
DEMO_MODE=false
CALDAV_SYNC_OPENIDS=

# LLM（暂不启用，后续接 OpenAI 兼容接口）
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
